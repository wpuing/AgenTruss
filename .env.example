# Copy to .env for local runs. Never commit real .env or production secrets.
# Docker Compose reads .env (not this file).

APP_ENV=development
STORAGE_BACKEND=memory
# production requires: STORAGE_BACKEND=postgres + DATABASE_URL + REDIS_URL + strong JWT_SECRET
# DATABASE_URL=postgresql+psycopg://agent:replace-me-strong-db-password@127.0.0.1:5432/agenttruss
# REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=changeme-dev-only-replace-me-32chars
# Preferred key for encrypting high-risk tool args at rest (Fernet). Production: set a strong value.
TICKET_ARGS_SECRET=changeme-dev-ticket-args-secret
DEMO_PASSWORD=changeme
ALLOW_DEMO_USERS=true
JWT_EXPIRE_MINUTES=480
RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10
# MAX_UPLOAD_BYTES=2097152

WORKFLOW_ENGINE=langgraph
AGENT_RUNTIME=single
AGENTSCOPE_ENABLED=false
AGENTSCOPE_TIMEOUT_MS=20000
AGENTSCOPE_MODEL_MODE=stub
# Admin console demo fixtures / visualizer drafts (forbidden in production)
ADMIN_DEMO_MODE=false
# mock = allow demo workflow drafts in UI; langgraph = prefer real stage rail only
WORKFLOW_VISUALIZER_MODE=mock
# memory | postgres — checkpointer preference (postgres when STORAGE_BACKEND=postgres)
CHECKPOINTER_BACKEND=memory
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=

# RAG defaults: Mock Embedding + Mock Vector Store (no API key / no Milvus required).
# Mock is for pipeline tests only — not real semantic retrieval / not durable across processes.
# Real providers: EMBEDDING_PROVIDER=openai|dashscope + matching API key (never silent-fallback to Mock).
# Write+query MUST share the same model/dim; changing dim/model requires re-vectorize.
# Optional live smoke: RUN_EMBEDDING_LIVE=1 with OPENAI_API_KEY or DASHSCOPE_API_KEY.
EMBEDDING_PROVIDER=mock
VECTOR_STORE_BACKEND=mock
EMBEDDING_DIM=8
# Legacy aliases still accepted: EMBEDDING_MODE=stub|mock, RAG_BACKEND=memory|mock|milvus
# EMBEDDING_MODE=mock
# RAG_BACKEND=mock
# EMBEDDING_MODEL=text-embedding-3-small
# To use real Milvus: VECTOR_STORE_BACKEND=milvus + MILVUS_URI + non-mock embedding + keys
# docker compose --profile object-store up -d   # optional MinIO
# docker compose --profile milvus up -d         # milvus (+ minio)

POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-me-strong-db-password
POSTGRES_DB=agenttruss
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-me-strong-minio-password
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=replace-me-strong-minio-password
# MINIO_BUCKET=agentruss
# MILVUS_URI=http://127.0.0.1:19530

# Integration test gates (skip ≠ pass):
# RUN_REDIS_INTEGRATION=1          # CI redis-integration job; default unit tests isolate Redis
# RUN_MINIO_INTEGRATION=1
# RUN_MILVUS_INTEGRATION=1         # needs MILVUS_URI; Compose --profile milvus
# RUN_PG_INTEGRATION=1
# RUN_AGENTSCOPE_LIVE=1            # needs DASHSCOPE_API_KEY or OPENAI_API_KEY + AGENTSCOPE_MODEL_MODE=live
# RUN_HTTP_ECHO_TOOL=1             # Echo = local protocol sandbox (not production)
# HTTP_ECHO_BASE_URL=http://127.0.0.1:8765/
# RUN_JSONPLACEHOLDER_TOOL=1       # demo HTTPS API only — not durable business lookup
# JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com

